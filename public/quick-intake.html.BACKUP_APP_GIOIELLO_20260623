<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>External Opinion — Avvia Screening</title>
<meta name="description" content="Prima di fare un'offerta o comprare un immobile, scopri dove sono i rischi." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
:root {
  --bg-0:#0a0a0c; --ink:#ECE6D6; --ink-dim:#9a917e;
  --gold-bright:#F6E08C; --gold:#DDB45E; --gold-deep:#9C7A33;
  --line:rgba(221,180,94,.42); --line-soft:rgba(221,180,94,.16); --field:#0c0c10;
  --green:#38B86E; --yellow:#F2C23B; --red:#C24234;
  --sans:"Inter",system-ui,-apple-system,sans-serif;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { margin: 0; }
body {
  font-family: var(--sans); color: var(--ink); min-height: 100vh;
  background: var(--bg-0);
  display: flex; flex-direction: column; align-items: center;
  padding: 0 16px 48px;
  -webkit-font-smoothing: antialiased;
}

/* NAV */
nav {
  width: 100%; max-width: 940px;
  display: flex; justify-content: space-between; align-items: center;
  padding: 18px 0 14px;
  border-bottom: 1px solid var(--line-soft);
  margin-bottom: 22px;
}
.nav-logo {
  font-size: 13px; font-weight: 600; letter-spacing: .09em;
  text-transform: uppercase; color: var(--gold); text-decoration: none;
}
.nav-back {
  font-size: 12px; color: var(--ink-dim); text-decoration: none;
  letter-spacing: .04em; transition: color .15s;
}
.nav-back:hover { color: var(--ink); }

/* STEPS */
#steps {
  width: 100%; max-width: 940px;
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 16px; font-size: 11.5px; color: var(--ink-dim);
}
.step { display: flex; align-items: center; gap: 6px; }
.step-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--line-soft); border: 1px solid var(--line-soft);
  flex-shrink: 0;
}
.step.active { color: var(--gold); }
.step.active .step-dot { background: var(--gold); border-color: var(--gold); }
.step.done { color: var(--green); }
.step.done .step-dot { background: var(--green); border-color: var(--green); }
.step-sep { width: 20px; height: 1px; background: var(--line-soft); }

/* STAGE (immagine + hotspot) */
.stage {
  position: relative; width: 100%; max-width: 940px;
  border-radius: 16px; overflow: hidden;
  box-shadow: 0 26px 64px -18px rgba(0,0,0,.85);
}
.stage .bg { display: block; width: 100%; height: auto; }

.hot {
  position: absolute; border: none; background: transparent;
  cursor: pointer; border-radius: 12px;
  transition: box-shadow .18s ease, background .18s ease;
}
.hot:hover {
  background: rgba(246,224,140,.07);
  box-shadow: 0 0 0 2px rgba(246,224,140,.65), 0 0 22px rgba(221,180,94,.4);
}
.hot:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--gold-bright), 0 0 22px rgba(221,180,94,.5);
}
/* .sel e .selected producono lo stesso effetto visivo */
.hot.sel,
.hot.selected {
  background: rgba(246,224,140,.05);
  box-shadow: 0 0 0 2px var(--gold-bright), 0 0 26px rgba(221,180,94,.5);
}
.hot.cta:hover,
.hot.cta:focus-visible {
  background: rgba(255,255,255,.10);
  box-shadow: 0 0 0 2px rgba(255,255,255,.55), 0 0 26px rgba(246,224,140,.6);
}

/* Pulse discoverability sugli hotspot categoria non ancora selezionati */
@keyframes hot-pulse {
  0%,100% { box-shadow: none; background: transparent; }
  50% { box-shadow: 0 0 0 2px rgba(246,224,140,.3), 0 0 18px rgba(221,180,94,.2); background: rgba(246,224,140,.03); }
}
.hot.cat-btn:not(.selected) { animation: hot-pulse 2.8s ease-in-out infinite; }
.hot.cat-btn:not(.selected):hover { animation: none; }

/* Pressione al click */
.hot:active { transform: scale(.96); transition: transform .07s ease, box-shadow .07s ease; }

/* Stato selezionato più luminoso */
.hot.selected {
  background: rgba(246,224,140,.09) !important;
  box-shadow: 0 0 0 2.5px var(--gold-bright), 0 0 32px rgba(221,180,94,.7) !important;
  animation: none !important;
}

/* INTAKE FORM (pannello sotto lo stage) */
#intake-form {
  width: 100%; max-width: 940px;
  overflow: hidden; max-height: 0; opacity: 0;
  transition: max-height .45s ease, opacity .3s ease, margin .3s ease;
}
#intake-form.visible {
  max-height: 700px; opacity: 1; margin-top: 14px;
}

/* CONFIRM PANEL */
#confirm-panel {
  display: none;
  width: 100%; max-width: 940px;
  margin-top: 14px;
}
#confirm-panel.visible { display: block; }

/* BOX (contenitore card dark) */
.box {
  background: linear-gradient(180deg, rgba(20,20,26,.96), rgba(12,12,16,.98));
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 20px;
}
.box h3 {
  font-weight: 600; font-size: 13px; margin: 0 0 14px;
  color: var(--gold); letter-spacing: .05em; text-transform: uppercase;
}

/* GRIGLIA CAMPI */
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.full { grid-column: 1 / -1; }
.fld label {
  display: block; font-size: 11px; color: var(--ink-dim); margin: 0 0 6px;
}
.fld input, .fld textarea {
  width: 100%; background: var(--field);
  border: 1px solid var(--line-soft); border-radius: 10px;
  color: var(--ink); font-family: var(--sans); font-size: 13.5px;
  padding: 12px; outline: none;
  transition: border-color .2s, box-shadow .2s;
}
.fld textarea { min-height: 80px; resize: vertical; line-height: 1.5; }
.fld input:focus, .fld textarea:focus {
  border-color: var(--gold);
  box-shadow: 0 0 0 3px rgba(221,180,94,.12);
}
.fld input::placeholder, .fld textarea::placeholder { color: #6c6557; }

/* Errori campo */
.fld.has-error input,
.fld.has-error textarea { border-color: var(--red); }
.error {
  font-size: 11px; color: var(--red);
  margin-top: 5px; display: none;
}
.fld.has-error .error { display: block; }

/* Documenti disponibili */
.allegati-section { margin-top: 4px; }
.allegati-label {
  font-size: 11px; font-weight: 600; letter-spacing: .06em;
  text-transform: uppercase; color: var(--ink-dim); margin-bottom: 8px;
}
.allegati-hint {
  font-weight: 400; text-transform: none; letter-spacing: 0;
  font-style: italic; color: var(--ink-dim); opacity: .6; margin-left: 6px;
}
.allegati-grid { display: flex; flex-wrap: wrap; gap: 6px; }
.a-chip {
  padding: 4px 10px; border: 1px solid var(--line-soft);
  background: transparent; color: var(--ink-dim); border-radius: 4px;
  font-size: 11.5px; cursor: pointer; transition: border-color .15s, color .15s;
}
.a-chip:hover { border-color: var(--gold); color: var(--ink); }
.a-chip.sel { border-color: var(--gold-bright); color: var(--gold-bright); background: rgba(246,224,140,.07); }

/* Errore globale */
.global-error {
  background: rgba(194,66,52,.10); border: 1px solid rgba(194,66,52,.4);
  border-radius: 8px; padding: 10px 12px;
  color: #e07060; font-size: 12.5px; line-height: 1.5;
  display: none; margin-bottom: 12px;
}
.global-error.visible { display: block; }

/* ROW azioni */
.row {
  display: flex; align-items: center;
  justify-content: flex-end; gap: 14px; margin-top: 14px;
}

/* LOADING */
.loading-state {
  font-size: 12px; color: var(--ink-dim);
  display: none; align-items: center; gap: 8px;
}
.loading-state.visible { display: flex; }
.spinner {
  width: 16px; height: 16px;
  border: 2px solid var(--line-soft);
  border-top-color: var(--gold);
  border-radius: 50%;
  animation: spin .8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* BOTTONE PRINCIPALE */
.btn-go {
  appearance: none; cursor: pointer; border: none;
  font-family: var(--sans); font-weight: 700; font-size: 14px;
  letter-spacing: .1em; color: #3a2c08;
  padding: 14px 28px; border-radius: 11px;
  display: inline-flex; align-items: center; gap: 10px;
  background: linear-gradient(180deg,#F8E59A 0%,#E9C868 46%,#D2A847 100%);
  box-shadow: 0 10px 22px -10px rgba(221,180,94,.6), inset 0 1px 0 rgba(255,255,255,.6);
  transition: transform .15s, opacity .2s;
  text-decoration: none;
}
.btn-go:hover:not(:disabled) { transform: translateY(-2px); }
.btn-go:disabled { opacity: .45; cursor: not-allowed; }

/* HINT */
.fld .hint {
  font-size: 11px; color: var(--ink-dim); margin-top: 5px; line-height: 1.5;
}

/* CONFIRM PANEL — contenuto */
.confirm-summary {
  list-style: none; margin: 14px 0 0;
  border-top: 1px solid var(--line-soft); padding-top: 12px;
}
.confirm-summary li {
  display: flex; gap: 12px;
  font-size: 12.5px; padding: 6px 0;
  border-bottom: 1px solid var(--line-soft);
}
.confirm-summary li:last-child { border-bottom: none; }
.confirm-summary .lbl { color: var(--ink-dim); min-width: 80px; }

.case-id-label {
  font-size: 11px; color: var(--ink-dim);
  letter-spacing: .1em; text-transform: uppercase; margin-bottom: 4px;
}
.case-id-val {
  font-weight: 700; font-size: 22px;
  color: var(--gold-bright); letter-spacing: .04em;
}
.case-id-copy {
  font-size: 12px; color: var(--ink-dim);
  cursor: pointer; text-decoration: underline;
  text-decoration-style: dotted; margin-top: 2px;
}
.case-id-copy:hover { color: var(--ink); }

.confirm-section { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line-soft); }
.confirm-section h4 {
  font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
  color: var(--ink-dim); margin-bottom: 6px;
}
.confirm-section p { font-size: 12.5px; color: var(--ink-dim); line-height: 1.6; }
.confirm-section strong { color: var(--gold); }

.confirm-actions { display: flex; flex-direction: column; gap: 8px; margin-top: 16px; }

.btn-new {
  appearance: none; cursor: pointer;
  font-family: var(--sans); font-size: 12.5px; font-weight: 500;
  color: var(--ink-dim); background: transparent;
  border: 1px solid var(--line-soft); border-radius: 10px;
  padding: 12px 20px; transition: border-color .2s, color .2s;
}
.btn-new:hover { border-color: var(--line); color: var(--ink); }

@media (max-width: 560px) {
  .grid { grid-template-columns: 1fr; }
  .row { flex-direction: column; align-items: stretch; }
  .btn-go { justify-content: center; }
  nav { padding: 14px 0 12px; }
}
</style>
</head>
<body>

<nav>
  <a class="nav-logo" href="/">External Opinion</a>
  <a class="nav-back" href="/landing.html">← Home</a>
</nav>

<!-- STEP INDICATOR -->
<div id="steps">
  <span class="step active" id="step-1">
    <span class="step-dot"></span>
    Tipo di caso
  </span>
  <span class="step-sep"></span>
  <span class="step" id="step-2">
    <span class="step-dot"></span>
    Link e contatto
  </span>
  <span class="step-sep"></span>
  <span class="step" id="step-3">
    <span class="step-dot"></span>
    Conferma
  </span>
</div>

<!-- STAGE — grafica con hotspot categorie -->
<div id="cat-section">
  <div class="stage">
    <img class="bg" src="data:image/png;base64," alt="External Opinion — scegli il caso" />

    <!-- Hotspot categorie: classe cat-btn + data-service/label per quick-intake.js -->
    <button class="hot sel cat-btn" data-case="prima-casa"
            data-service="prima-casa" data-label="Prima casa"
            aria-label="Prima casa"
            style="left:11.18%;top:62.91%;width:14.35%;height:12.13%"></button>

    <button class="hot cat-btn" data-case="investimento"
            data-service="investimento" data-label="Investimento immobiliare"
            aria-label="Investimento"
            style="left:26.90%;top:62.91%;width:14.24%;height:12.13%"></button>

    <button class="hot cat-btn" data-case="asta"
            data-service="asta" data-label="Asta immobiliare"
            aria-label="Aste immobiliari"
            style="left:42.51%;top:62.91%;width:14.24%;height:12.13%"></button>

    <button class="hot cat-btn" data-case="compravendita"
            data-service="compravendita" data-label="Compravendita immobiliare"
            aria-label="Compravendita"
            style="left:58.12%;top:62.91%;width:14.24%;height:12.13%"></button>

    <button class="hot cat-btn" data-case="difformita"
            data-service="analisi-tecnica" data-label="Analisi tecnica / normativa"
            aria-label="Difformità"
            style="left:73.73%;top:62.91%;width:14.24%;height:12.13%"></button>

    <!-- Hotspot CTA "INIZIA ANALISI" -->
    <button class="hot cta" id="go" aria-label="Inizia analisi"
            style="left:55.70%;top:86.60%;width:32.49%;height:8.46%"></button>
  </div>
</div>

<!-- FORM (step 2) -->
<div id="intake-form">
  <div class="box">
    <h3>Inserisci i dettagli</h3>
    <div id="tipo-badge" style="margin-bottom:12px;padding:5px 10px;background:rgba(246,224,140,.08);border:1px solid rgba(246,224,140,.28);border-radius:6px;font-size:11px;color:var(--gold-bright);letter-spacing:.07em;text-transform:uppercase;"></div>

    <div class="global-error" id="global-error"></div>

    <div class="grid">
      <div class="fld full" id="field-url">
        <label>Link immobile / asta / annuncio</label>
        <input type="url" id="input-url"
               placeholder="https://www.immobiliare.it/annunci/... oppure link portale aste"
               autocomplete="off" />
        <div class="hint">Portali accettati: immobiliare.it, idealista, pvp.giustizia.it, qualsiasi URL pubblico</div>
        <div class="error" id="error-url">Inserisci un link valido (inizia con http:// o https://)</div>
      </div>
    </div>

    <div class="allegati-section">
      <div class="allegati-label">Documenti disponibili <span class="allegati-hint">opzionale — invia via email al codice caso</span></div>
      <div class="allegati-grid">
        <button class="a-chip" data-doc="planimetria"    type="button">Planimetria</button>
        <button class="a-chip" data-doc="foto"           type="button">Foto</button>
        <button class="a-chip" data-doc="perizia"        type="button">Perizia</button>
        <button class="a-chip" data-doc="visura"         type="button">Visura</button>
        <button class="a-chip" data-doc="ape"            type="button">APE</button>
        <button class="a-chip" data-doc="documenti-asta" type="button">Doc. Asta</button>
        <button class="a-chip" data-doc="computo"        type="button">Computo</button>
        <button class="a-chip" data-doc="note-cliente"   type="button">Note</button>
      </div>
    </div>

    <div class="grid">
      <div class="fld" id="field-contact">
        <label>Email o telefono</label>
        <input type="text" id="input-contact"
               placeholder="email@esempio.it oppure +39 333 …"
               autocomplete="email" />
        <div class="error" id="error-contact">Inserisci email o telefono</div>
      </div>

      <div class="fld">
        <label>Note <span style="color:var(--ink-dim);font-weight:400">(facoltativo)</span></label>
        <textarea id="input-note"
                  placeholder="Informazioni aggiuntive: prezzo base, zona, documenti disponibili…"></textarea>
      </div>
    </div>

    <div class="row">
      <div class="loading-state" id="loading-state">
        <div class="spinner"></div>
        <span>Creazione caso in corso…</span>
      </div>
      <button class="btn-go" id="submit-btn" type="button">
        Avvia Analisi Oggettiva
      </button>
    </div>
  </div>
</div>

<!-- CONFIRM (step 3) -->
<div id="confirm-panel">
  <div class="box">
    <div class="case-id-label">Caso ricevuto</div>
    <div class="case-id-val" id="display-case-id">EO---------</div>
    <div class="case-id-copy" id="copy-btn">Copia codice</div>

    <ul class="confirm-summary" id="confirm-summary">
      <li><span class="lbl">Tipo</span><span id="summary-tipo">—</span></li>
      <li><span class="lbl">Link</span><span id="summary-url">—</span></li>
      <li><span class="lbl">Contatto</span><span id="summary-contact">—</span></li>
    </ul>

    <div class="confirm-section">
      <h4>Prossima fase</h4>
      <p>Procedi al pagamento per avviare l'analisi completa. Il report sarà disponibile entro 24–48 ore.</p>
    </div>

    <div class="confirm-section">
      <h4>Documenti facoltativi</h4>
      <p>Se hai perizia, planimetria, APE o visure, inviaci i documenti a <strong>documents@externalopinion.it</strong> indicando il codice caso.</p>
    </div>

    <div class="confirm-actions">
      <a class="btn-go" id="checkout-btn" href="#" target="_blank">
        Procedi al pagamento →
      </a>
      <button class="btn-new" id="new-case-btn" type="button">
        Inizia un nuovo caso
      </button>
    </div>
  </div>
</div>

<script src="/quick-intake.js"></script>
<script>
// Bridge: hotspot #go → apre il form (equivale a cliccare la categoria selezionata)
document.getElementById('go').addEventListener('click', function () {
  var selected = document.querySelector('.cat-btn.selected');
  var form = document.getElementById('intake-form');
  if (selected) {
    form.classList.add('visible');
    form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  } else {
    var first = document.querySelector('.cat-btn');
    if (first) first.click();
  }
});

// Sync visivo: .selected (da quick-intake.js) → .sel (hotspot highlight)
document.querySelectorAll('.hot.cat-btn').forEach(function (btn) {
  new MutationObserver(function () {
    btn.classList.toggle('sel', btn.classList.contains('selected'));
  }).observe(btn, { attributes: true, attributeFilter: ['class'] });
});

// Fix selezione esclusiva: rimuove .sel da tutti prima che il MutationObserver
// lo riassegni solo al pulsante cliccato (evita doppio highlight con stato iniziale)
document.querySelectorAll('.hot.cat-btn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    document.querySelectorAll('.hot.cat-btn').forEach(function (b) { b.classList.remove('sel'); });
  });
});
</script>
</body>
</html>
