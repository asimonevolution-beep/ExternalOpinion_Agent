{
  "name": "external-opinion-agent",
  "version": "13.1.0",
  "description": "Production-ready External Opinion platform for PDF processing, cash flow analysis, WhatsApp notifications, and REST API integration.",
  "main": "server-v18.3.js",
  "scripts": {
    "start": "node server-v18.3.js",
    "worker": "node worker.js",
    "build": "prisma generate",
    "postinstall": "prisma generate --no-hints || true",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "deploy": "node scripts/fs-gatekeeper.js && netlify deploy --prod",
    "cascade:action2": "node scripts/patch-action2-roi.cjs && node scripts/verify-action2-roi.cjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@opentelemetry/api": "^1.9.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.53.1",
    "axios": "^1.4.0",
    "bullmq": "^2.4.0",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.10.1",
    "morgan": "^1.10.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.0",
    "pino": "^8.16.0",
    "prom-client": "^15.1.3",
    "prisma": "^5.22.0",
    "redis": "^5.12.1",
    "sharp": "^0.33.5",
    "stripe": "^22.1.1",
    "resend": "^4.0.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "puppeteer": "^21.0.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "twilio": "^6.0.2",
    "openai": "^4.0.0",
    "@google/generative-ai": "^0.7.0",
    "ollama": "^0.5.0"
  },
  "devDependencies": {}
}