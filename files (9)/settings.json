{
  "permissions": {
    "allow": [
      "Read", "Glob", "Grep", "Edit", "Write",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(git add:*)", "Bash(git commit:*)",
      "Bash(npm run lint:*)", "Bash(npm run test:*)", "Bash(npm test:*)",
      "Bash(npx tsc:*)", "Bash(node:*)"
    ],
    "deny": [
      "Bash(npm install puppeteer:*)", "Bash(npm i puppeteer:*)",
      "Bash(npm install bullmq:*)", "Bash(npm i bullmq:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)", "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh", "timeout": 900 }
        ]
      }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/notify.sh attesa" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/notify.sh fine" } ] }
    ]
  }
}
