ll required",id:"/9flobnPjq"}),description:t.jsx(SO,{defaultMessage:"Cowork requires Claude Desktop to be installed via a modern installer",id:"2QF7xrKrSb"}),action:{label:t.jsx(SO,{defaultMessage:"Reinstall",id:"AQkpi3vGmC"}),href:"https://claude.com/download"}};case"disabled_by_enterprise":case"disabled_by_user":return{title:t.jsx(SO,{defaultMessage:"Feature disabled",id:"9QHy+wVPnn"}),description:t.jsxs(t.Fragment,{children:[t.jsx(SO,{defaultMessage:"This feature is not currently enabled.",id:"rlYXer5sSI"}),s&&` ${s}`]})};case"hcs_not_available":return{title:t.jsx(SO,{defaultMessage:"Virtual Machine Platform not available",id:"yjT816WO9C"}),description:t.jsx(SO,{defaultMessage:"Claude's workspace requires the Virtual Machine Platform on Windows. Enable this feature, then restart.",id:"iep0DbgP9t"})};case"virtualization_not_available":return{title:t.jsx(SO,{defaultMessage:"Virtualization not available",id:"5GBjSsN9NR"}),description:Be()?t.jsx(SO,{defaultMessage:"Claude's workspace requires hardware virtualization. Enable virtualization in your computer's BIOS/UEFI settings, then restart.",id:"sp6+8env02"}):t.jsx(SO,{defaultMessage:"Cowork requires virtualization. Your Mac does not support virtualization. If you are currently running macOS inside a virtual machine (like Parallels), you might need to enable a feature called 'nested virtualization'.",id:"C/K/kK/zlp"})};case"virtualization_entitlement_missing":return{title:t.jsx(SO,{defaultMessage:"Invalid installation",id:"Vkjh8SA/t8"}),description:t.jsx(SO,{defaultMessage:"Claude's installation appears to be corrupted. Reinstall Claude from claude.com/download to use this feature.",id:"oqcioCyuAP"})};default:return null}}(e,s);if(!n)return null;const{title:a,description:i}=n;return t.jsx("div",{role:"status",className:"bg-bg-200 border-0.5 border-border-400 rounded-xl p-4 w-full max-w-2xl mx-auto mb-3",children:t.jsxs("div",{className:"flex items-start gap-3",children:[t.jsx("div",{className:"flex items-center justify-center pl-1.5 pt-0.5",children:t.jsx(AF,{className:"w-5 h-5 text-text-300 shrink-0",weight:"fill"})}),t.jsxs("div",{className:"flex flex-col gap-1",children:[t.jsx("span",{className:"text-sm font-medium text-text-000",children:a}),t.jsx("span",{className:"text-sm text-text-200",children:i})]})]})})});const WYt=s(GN());var GYt,KYt;const YYt=s(function(){if(KYt)return GYt;KYt=1;const e=KN();return GYt=(t,s,n)=>e(s,t,n)}()),JYt={releases:JSON.parse('[{"version":"1.13576.0","date":"2026-06-16","entries":[{"surface":"general","kind":"improvement","text":"Improved find-in-page to search the entire session transcript instead of only the text scrolled into view, and the find bar now reliably takes keyboard focus when opened."},{"surface":"general","kind":"feat","text":"Added a unified Artifacts view that lists your chat, Code, and Cowork artifacts in one searchable place, with a \\"New artifact\\" menu and a \\"Filter by\\" control to narrow the list by source."},{"surface":"general","kind":"fix","text":"Fixed keyboard shortcut conflicts failing silently. Assigning a shortcut already held by another app now tells you and keeps your previous shortcut working, and Quick Entry registration errors now appear in Settings."},{"surface":"general","kind":"fix","text":"Fixed the first-run notification explaining that Claude keeps running in the notification area never appearing on Windows."},{"surface":"code","kind":"feat","text":"Added running dev servers to the Background tasks panel, with stop and open-preview actions."},{"surface":"code","kind":"improvement","text":"Improved the Code file viewer: images, video, and audio now play inline instead of showing as text, and Markdown, CSV, and image files refresh automatically when Claude edits them."},{"surface":"code","kind":"improvement","text":"Updated the model picker. The three headline models appear at the top level with older models and context-size variants under \\"More models\\", each model shows a capability description, and currently-unavailable models appear disabled instead of failing when selected."},{"surface":"code","kind":"improvement","text":"Updated the in-session artifact panel: switch between a session\'s published artifacts from the title dropdown, see when an artifact was last updated, copy a share link, and open, share, or delete the artifact from the overflow menu."},{"surface":"code","kind":"improvement","text":"Changed the Code sessions tab from \\"Projects\\" to \\"All sessions\\". It now lists your non-project sessions alongside project sessions and adds a multi-select Environment filter."},{"surface":"code","kind":"fix","text":"Fixed pull request status checks. Failures now show a small warning indicator on the branch row instead of repeated error popups, the \\"status couldn\'t be checked\\" warning appears less often and can always be dismissed, and only GitHub CLI sign-in problems still raise a notification."},{"surface":"cowork","kind":"fix","text":"Fixed corrupt plugin downloads crashing or hanging the app."},{"surface":"cowork","kind":"fix","text":"Fixed skills sometimes staying on an older version after being edited until toggled off and on."},{"surface":"3p","kind":"feat","text":"Added the Chat tab as a beta feature controlled by the `chatTabEnabled` managed configuration key. The separate `chatCodeExecutionEnabled` key lets Claude analyze attachments and create files such as spreadsheets and presentations by running code in an isolated sandbox scoped to the session\'s attachments, and is off by default."},{"surface":"3p","kind":"feat","text":"Added the `betaFeaturesEnabled` managed configuration key. Setting it to false disables every beta feature in the deployment, including the Chat tab."},{"surface":"3p","kind":"feat","text":"Added Bedrock Mantle as an inference provider option. It reuses the existing `inferenceBedrockRegion` and `inferenceBedrockBaseUrl` managed configuration keys and authenticates with a bearer token or a credential helper."},{"surface":"3p","kind":"feat","text":"Added `anthropicFamilyTier` and `isFamilyDefault` to managed `inferenceModels` entries. Tag each configured model with the Claude tier it stands in for so tier shortcuts like opus and sonnet resolve to your configured model IDs instead of the canonical names your provider may not route."},{"surface":"3p","kind":"feat","text":"Added the `inferenceBedrockAwsCliPath` managed configuration key to set the AWS CLI\'s absolute path. This fixes aws sso login failing when the app is launched from Finder on macOS and the CLI is not on the default search path."},{"surface":"3p","kind":"fix","text":"Fixed Google Workspace connectors never starting their OAuth sign-in. The MCP client identifier the app sends to connected servers is now `claude-desktop-3p`, changed from `custom3p-desktop`, so update any MCP server allowlists or log filters that match the old value."},{"surface":"3p","kind":"fix","text":"Fixed the managed Tool policy `*` entry being ignored. It now applies as the default for any tool not listed by name."},{"surface":"3p","kind":"fix","text":"Fixed organization plugins sometimes not opening from the Directory right after launch or update."},{"surface":"3p","kind":"fix","text":"Fixed several connection and sign-in issues: Bedrock sessions now prompt to sign in again after AWS IAM Identity Center expires instead of failing with repeated credential errors, remote MCP connectors no longer stay Connected after a non-refreshable access token expires, the connection test now passes against gateways that optionally request a TLS client certificate, signing in after signing out no longer needs a double click, and sign-in recovery no longer uses stale configuration after a server-side update or leaves the model picker empty until restart."}]},{"version":"1.12603.1","date":"2026-06-11","entries":[{"surface":"general","kind":"feat","text":"Added Find Next and Find Previous keyboard shortcuts to in-app search."},{"surface":"general","kind":"fix","text":"Fixed preview panes stealing keyboard focus from the chat input when they reloaded or navigated."},{"surface":"general","kind":"fix","text":"Fixed sessions failing to start after your sign-in expired \u2014 the app now prompts you to sign in again."},{"surface":"code","kind":"feat","text":"Added the Files panel to remote and SSH sessions \u2014 search the session\'s files and open them in the viewer \u2014 plus a Show in Files button in the file viewer."},{"surface":"code","kind":"feat","text":"Added a running-tasks button to the activity indicator that opens the Tasks panel, and Bash rows in the Background tasks panel now open to show their output, including a live tail while the command runs."},{"surface":"code","kind":"fix","text":"Fixed SSH sessions: forking no longer opens an empty conversation, and connections no longer fail with \\"Failed to upload file\\" errors on remotes first set up by early-2026 versions of the app."},{"surface":"code","kind":"fix","text":"Fixed renaming a session while its title was still generating \u2014 the generated title no longer overwrites the name you set."},{"surface":"code","kind":"fix","text":"Fixed the Pull Requests view showing \\"No open pull requests\\" when GitHub isn\'t connected \u2014 it now prompts you to connect."},{"surface":"code","kind":"feat","text":"Added model-picker memory \u2014 the picker now remembers your last model choice."},{"surface":"cowork","kind":"fix","text":"Fixed scheduled tasks firing many duplicate runs at once when the computer wakes from sleep."},{"surface":"cowork","kind":"fix","text":"Fixed remote sessions re-prompting for access to folders you had already trusted."},{"surface":"cowork","kind":"fix","text":"Fixed plugins becoming corrupted when they synced while you switched accounts."},{"surface":"3p","kind":"feat","text":"Added the built-in Microsoft 365 connector \u2014 admins can configure it from the Setup window\'s server presets. Users sign in through their browser, and Claude can search and read Microsoft 365 mail, calendar, OneDrive, and SharePoint. It requests read-only access by default; admins can grant additional read scopes, such as Teams channel messages and meeting transcripts, with the managed server entry\'s scope setting."},{"surface":"3p","kind":"improvement","text":"Deprecated the \\"sso\\" value for the inferenceGatewayAuthScheme managed configuration key in favor of inferenceCredentialKind \\"interactive\\" \u2014 existing configurations keep working and log a deprecation warning."},{"surface":"3p","kind":"feat","text":"Added the inferenceVertexOAuthLoginHint managed configuration key to pre-fill the Google account chooser when signing in to Vertex AI, so users in organizations federated to a third-party identity provider land on the right account automatically."}]},{"version":"1.11847.5","date":"2026-06-09","entries":[{"surface":"general","kind":"fix","text":"Fixed Clear Cache and Restart signing you out instead of just clearing caches."},{"surface":"general","kind":"fix","text":"Fixed mouse back and forward buttons not navigating on macOS for mice managed by driver software like Logitech Options+, and added trackpad swipe navigation."},{"surface":"general","kind":"fix","text":"Fixed organization plugins sometimes failing to open right after app launch, and the plugin directory now offers Install again after an uninstall."},{"surface":"general","kind":"fix","text":"Fixed connector, Chrome extension, and plugin toggles in the composer\'s \\"+\\" menu not responding when you click directly on the switch."},{"surface":"general","kind":"fix","text":"Fixed an issue where signing in could leave the app unable to start sessions until it was restarted."},{"surface":"general","kind":"fix","text":"Fixed shell-exported custom request headers not reaching Claude Code sessions."},{"surface":"code","kind":"fix","text":"Fixed Claude losing its coding instructions, file-link formatting, and worktree context after a session resumed from idle."},{"surface":"code","kind":"fix","text":"Fixed the preview pane sometimes connecting to an unrelated dev server that was already using the configured port, and it now reopens the dev server you last picked for each project."},{"surface":"code","kind":"improvement","text":"Improved responsiveness in Code sessions: smoother streaming of long code blocks, quicker side-panel shortcuts, and less delay opening cloud sessions with many screenshots."},{"surface":"code","kind":"fix","text":"Fixed popovers, dialogs, and the rewind picker not appearing \u2014 and typed characters jumping to the end of the composer \u2014 when a Code session is opened in its own window."},{"surface":"code","kind":"fix","text":"Fixed the slash-command menu opening behind the side chat panel."},{"surface":"code","kind":"fix","text":"Fixed the source-branch picker showing nothing for SSH sessions with worktree enabled."},{"surface":"cowork","kind":"feat","text":"Added a \\"Free Up Cowork Disk Space\\" option under Help > Troubleshooting, and Cowork now cleans up caches and old temporary files automatically when its workspace disk runs low."},{"surface":"cowork","kind":"improvement","text":"Improved the read/unread toggle on sidebar sessions: it now works on the currently open session, has a larger click target, and shows a tooltip describing what a click will do."},{"surface":"3p","kind":"feat","text":"Added support for the Fable model family, and for Mythos where your organization has access."},{"surface":"3p","kind":"fix","text":"Fixed sign-in failing with external identity providers that reject the offline_access scope \u2014 admins can now disable the automatic append."}]},{"version":"1.11187.4","date":"2026-06-05","entries":[{"surface":"general","kind":"fix","text":"Fixed reinstalling Claude on Windows failing after an uninstall when IT had installed it for all users."},{"surface":"general","kind":"fix","text":"Fixed the app not starting automatically at login on Windows."},{"surface":"general","kind":"feat","text":"Added a banner when an update fails to install, instead of failing silently."},{"surface":"general","kind":"fix","text":"Fixed built-in connectors staying disconnected after a crash \u2014 existing sessions now reconnect them automatically, and disconnecting a built-in connector now signs it out and keeps it disconnected across restarts."},{"surface":"code","kind":"feat","text":"Added math rendering for inline and block expressions in Claude Code transcripts."},{"surface":"code","kind":"feat","text":"Added Ultracode to the effort slider, which selects the highest effort level and turns on dynamic workflows for the session."},{"surface":"code","kind":"feat","text":"Added drag-to-reorder and A\u2192Z sorting for projects in the Claude Code sidebar."},{"surface":"code","kind":"feat","text":"Added triple-click to select a whole code block, plus right-click menu actions to copy a code block or inline code, in Claude Code transcripts."},{"surface":"code","kind":"fix","text":"Fixed resuming Code sessions when the working folder had moved or been deleted \u2014 sessions saved with a ~ path no longer show as missing or re-prompt for trust, and a deleted remote folder now reports clearly and offers a Fork session button instead of retrying in a loop."},{"surface":"cowork","kind":"feat","text":"Added a low-disk-space warning before Cowork downloads the files it needs to run."},{"surface":"cowork","kind":"feat","text":"Added in-session effort and thinking controls for local Cowork projects."},{"surface":"cowork","kind":"improvement","text":"Updated the New project folder picker to default to your Claude data folder (~/Claude/Projects) instead of ~/Documents."},{"surface":"cowork","kind":"fix","text":"Fixed Claude reporting that a skill was updated when the change was never saved to your account."},{"surface":"cowork","kind":"fix","text":"Fixed the /schedule command in Cowork showing as unavailable."},{"surface":"3p","kind":"fix","text":"Fixed managed connectors and SSO sign-in requesting broader OAuth scopes than the administrator configured."},{"surface":"3p","kind":"fix","text":"Fixed three Bedrock sign-in and session issues: SSO sign-in failing behind corporate proxies that intercept secure traffic, expired SSO tokens prompting a new sign-in every hour instead of refreshing automatically, and resumed sessions failing on their first message."}]}]')}.releases,QYt={code:new Set(["general","code"]),cowork:new Set(["general","cowork"])};function XYt(e){const t=QYt[e],s=new Set(t),n=JYt.map(e=>({version:e.version,date:e.date,items:e.entries.filter(e=>s.has(e.surface)).map(e=>({kind:e.kind,text:e.text}))})).filter(e=>e.items.length>0),a=new Set(JYt.filter(e=>e.entries.some(e=>t.has(e.surface))).map(e=>e.version)),i=new Map(n.map(e=>[e.version,e]));if("cowork"!==e)for(const r of eJt){if(a.has(r.version))continue;const e=i.get(r.version);i.set(r.version,e?{...e,items:[...e.items,...r.items]}:r)}return[...i.values()].filter(e=>et(e.version)).sort((e,t)=>YYt(e.version,t.version))}const eJt=[{version:"1.11187.0",date:"2026-06-04",items:[{kind:"improvement",text:EO({defaultMessage:"Click a filename on an Edited or Wrote row to open that file in the diff pane",id:"uJac4DtLEH"})},{kind:"improvement",text:EO({defaultMessage:"Project rows in the Recents sidebar expand with a click, and a hover-revealed `View project` button opens the project page",id:"Adm40w2OOS"})},{kind:"improvement",text:EO({defaultMessage:"When a remote session's working folder has been deleted, `Fork session` recovers it into a fresh worktree",id:"FKMFf4iqY+"})},{kind:"fix",text:EO({defaultMessage:"The floating side chat ([[cmd+;]]) remembers where you placed and sized it",id:"yxzcnV4kDy"})},{kind:"fix",text:EO({defaultMessage:"[[cmd+k]] finds sessions you started since opening the app, and searches branches inside folders",id:"os5Efgh+1R"})},{kind:"fix",text:EO({defaultMessage:"`Add plugin` from the + menu opens straight to the installable plugin 